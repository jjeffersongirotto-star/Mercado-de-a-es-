<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Grupo simulação: marca comprida ou logo (abre o app) | seletor do grupo ▾ | horário | ⟳ ; títulos (centralizados, 2 linhas); lista plana: modelos e, do aberto, título das posições, uma linha por empresa e o CDB (SimWidget) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/s_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_legacy" />
        <!-- marca comprida (nome curto, como no widget Favoritos): até o seletor s_sel2, colado ao horário; nome longo: logo quadrado -->
        <ImageView
            android:id="@+id/s_brand"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="@string/app_name"
            android:scaleType="fitStart"
            android:src="@drawable/ic_brand"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/s_mid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:id="@+id/s_sel"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/sel_chip"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:text="@string/sim_sel"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
        <TextView
            android:id="@+id/s_sel2"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/sel_chip"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/s_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/c_mut"
            android:textSize="11sp" />

        <!-- ⬇ planilha .xlsx do grupo (Resumo + uma aba por modelo) em Downloads, pelo DownloadManager (SimWidget.download) -->
        <TextView
            android:id="@+id/s_dl"
            android:layout_width="30dp"
            android:layout_height="34dp"
            android:contentDescription="@string/sim_dl"
            android:gravity="center"
            android:text="⬇"
            android:textColor="@color/c_txt"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/s_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_refresh"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/c_txt"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/s_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:textColor="@color/c_mut"
        android:textSize="10.5sp" />

    <LinearLayout
        android:id="@+id/s_cols"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:text="@string/sim_col_m" android:textColor="@color/c_mut" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="@dimen/sim_np" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:text="@string/sim_col_np" android:textColor="@color/c_mut" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="@dimen/sim_ap" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:lineSpacingMultiplier="0.9"
            android:text="@string/sim_col_ap" android:textColor="@color/c_mut" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="@dimen/sim_v" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:lineSpacingMultiplier="0.9"
            android:text="@string/sim_col_v" android:textColor="@color/c_mut" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="@dimen/sim_d" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:lineSpacingMultiplier="0.9"
            android:text="@string/sim_col_d" android:textColor="@color/c_mut" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bd" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/s_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/s_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/sim_empty"
            android:textColor="@color/c_mut"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
