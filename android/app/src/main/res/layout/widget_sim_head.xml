<?xml version="1.0" encoding="utf-8"?>
<!-- modelo aberto no widget Grupo simulação: "Posições atuais · N empresas" e "↗ abrir" (movimentações do modelo no app); títulos das colunas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_sec"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/h_ph" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:textColor="@color/c_txt" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/h_open" android:layout_width="wrap_content" android:layout_height="28dp" android:contentDescription="@string/open_app"
            android:gravity="center" android:paddingStart="8dp" android:paddingEnd="6dp" android:text="↗ abrir" android:textColor="@color/c_pos" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/sim_pos_t"
            android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
        <TextView android:layout_width="@dimen/sim_q" android:layout_height="wrap_content" android:gravity="center" android:text="@string/sim_pos_q"
            android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
        <TextView android:layout_width="@dimen/sim_pv" android:layout_height="wrap_content" android:gravity="center" android:text="@string/sim_pos_inv"
            android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
        <TextView android:layout_width="@dimen/sim_pv" android:layout_height="wrap_content" android:gravity="center" android:text="@string/sim_pos_v"
            android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
