<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:text="@string/widget_name"
            android:textColor="@color/c_amber"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/c_mut"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_refresh"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/c_txt"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingBottom="2dp">
        <TextView android:layout_width="@dimen/col_t" android:layout_height="wrap_content" android:gravity="start" android:maxLines="1"
            android:text="@string/col_t" android:textColor="@color/c_dim" android:textSize="9sp" />
        <TextView android:layout_width="@dimen/col_p" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1"
            android:text="@string/col_p" android:textColor="@color/c_dim" android:textSize="9sp" />
        <TextView android:layout_width="@dimen/col_v" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1"
            android:text="@string/col_v" android:textColor="@color/c_dim" android:textSize="9sp" />
        <TextView android:layout_width="@dimen/col_f" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:text="@string/col_f" android:textColor="@color/c_dim" android:textSize="9sp" />
        <TextView android:layout_width="@dimen/col_g" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:text="@string/col_g" android:textColor="@color/c_dim" android:textSize="9sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/bg_sec"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/widget_empty"
            android:textColor="@color/c_mut"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
