<?xml version="1.0" encoding="utf-8"?>
<!-- Widget: logo (marca comprida ou, com nome de grupo longo, o quadrado; abre o app: FavWidget.render → WidgetData.longLogo) | seletor Favoritos/grupo ▾ | horário dos dados | ⟳ ; aviso de nova versão (só quando há); títulos das colunas; linhas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_legacy" />

        <!-- marca comprida (nome curto): ocupa até o seletor w_sel2, que fica colado ao horário; bitmap montado em FavWidget.brand -->
        <ImageView
            android:id="@+id/w_brand"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="@string/app_name"
            android:scaleType="fitStart"
            android:src="@drawable/ic_brand"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/w_mid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/w_sel"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/sel_chip"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:text="@string/fav_sel"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/w_sel2"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/sel_chip"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/c_mut"
            android:textSize="11sp" 
            android:gravity="end"
            android:maxLines="2"
            android:lineSpacingMultiplier="0.9" />

        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_refresh"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/c_txt"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_upd"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/upd_chip"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/c_pos"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- títulos das colunas: altura fixa (WidgetData.colsDp, pela escala de fonte) para a conta das linhas inteiras (WidgetData.rows) -->
    <LinearLayout
        android:id="@+id/w_cols"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="start" android:maxLines="1"
            android:ellipsize="end" android:text="@string/col_t" android:textColor="@color/c_mut" android:textSize="10.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/h_p" android:layout_width="@dimen/col_p" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:ellipsize="end" android:text="@string/col_p" android:textColor="@color/c_mut" android:textSize="10.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/h_v" android:layout_width="@dimen/col_v" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:ellipsize="end" android:text="@string/col_v" android:textColor="@color/c_mut" android:textSize="10.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/h_f" android:layout_width="@dimen/col_f" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2"
            android:ellipsize="end" android:text="@string/col_f" android:textColor="@color/c_mut" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/h_g" android:layout_width="@dimen/col_g" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2"
            android:ellipsize="end" android:text="@string/col_g" android:textColor="@color/c_mut" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bd" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/widget_empty"
            android:textColor="@color/c_mut"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
