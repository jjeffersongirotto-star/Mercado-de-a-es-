<?xml version="1.0" encoding="utf-8"?>
<!-- linha do widget Grupo simulação: modelo (rendimento total embaixo) | aportado | atual | dia (% e R$); aberta: posições atuais
     (empresa, nº de ações, investido, atual) e "↗ abrir" (movimentações do modelo no app) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/q_main"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/q_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end"
                android:maxLines="2" android:lineSpacingMultiplier="0.9" android:textColor="@android:color/white" android:textSize="12.5sp" android:textStyle="bold" />
            <TextView android:id="@+id/q_tot" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1"
                android:textSize="10.5sp" />
        </LinearLayout>
        <TextView android:id="@+id/q_ap" android:layout_width="@dimen/sim_ap" android:layout_height="wrap_content" android:gravity="end"
            android:maxLines="1" android:textColor="@color/c_dim" android:textSize="12sp" />
        <TextView android:id="@+id/q_v" android:layout_width="@dimen/sim_v" android:layout_height="wrap_content" android:gravity="end"
            android:maxLines="1" android:textColor="@color/c_txt" android:textSize="12.5sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="@dimen/sim_d" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical"
            android:paddingEnd="2dp">
            <TextView android:id="@+id/q_dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/q_dv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/q_exp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_sec"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/q_ph" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:maxLines="1" android:textColor="@color/c_txt" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/q_open" android:layout_width="wrap_content" android:layout_height="28dp" android:contentDescription="@string/open_app"
                android:gravity="center" android:paddingStart="8dp" android:paddingEnd="6dp" android:text="↗ abrir" android:textColor="@color/c_pos" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/sim_pos_t"
                android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
            <TextView android:layout_width="@dimen/sim_q" android:layout_height="wrap_content" android:gravity="end" android:text="@string/sim_pos_q"
                android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
            <TextView android:layout_width="@dimen/sim_v" android:layout_height="wrap_content" android:gravity="end" android:text="@string/sim_pos_inv"
                android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
            <TextView android:layout_width="@dimen/sim_v" android:layout_height="wrap_content" android:gravity="end" android:paddingEnd="2dp" android:text="@string/sim_pos_v"
                android:textColor="@color/c_mut" android:textSize="9.5sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/q_pos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/q_rest" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp"
            android:maxLines="1" android:textColor="@color/c_mut" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
